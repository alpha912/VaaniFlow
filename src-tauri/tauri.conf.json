{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.vaaniflow.app",
  "productName": "VaaniFlow",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "VaaniFlow — Settings",
        "url": "index.html",
        "width": 560,
        "height": 640,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true,
        "focus": true
      },
      {
        "label": "bubble",
        "title": "VaaniFlow",
        "url": "bubble.html",
        "width": 200,
        "height": 120,
        "minWidth": 200,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "VaaniFlow — Click a text field to start"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
